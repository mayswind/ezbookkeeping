# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，只存在于服务器，绝不提交 git。
# 改完用 docker compose config 检查变量是否都替换成功。

# ===== 应用镜像 =====
# 默认用自己 CI 构建的镜像；想临时验证作者镜像可改为 mayswind/ezbookkeeping:latest
EBK_IMAGE=gaofei211/bookkeeping:latest

# ===== 数据库名：切换 stg / prod 只改这一行 =====
EBK_DATABASE_NAME=ezbookkeeping_stg
# EBK_DATABASE_NAME=ezbookkeeping_prod

# ===== 数据库账号 =====
EBK_DATABASE_USER=ezbookkeeping
# 应用连库用的密码；它同时也是 MySQL 首次初始化创建该用户时的密码，两处必须一致（compose 已用同一变量引用）
EBK_DATABASE_PASSWD=change_me_strong_password
# MySQL root 密码（仅 root 用，和上面的应用用户密码不是一回事）
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# ===== 安全密钥 =====
# 用 openssl rand -base64 32 生成；定下后别乱改（改了所有已登录用户 token 失效需重新登录）
EBK_SECURITY_SECRET_KEY=change_me_run_openssl_rand_base64_32

# ===== 对外地址 =====
# 头像/图片/邮件链接/第三方登录回调/二维码都靠 ROOT_URL 生成，必须是 https:// 且不带 :8080
# EBK_SERVER_DOMAIN 同时也被 Caddyfile 读取用于申请 HTTPS 证书，换域名只改这里即可
EBK_SERVER_DOMAIN=bookkeeping.highfly-ai.com
EBK_SERVER_ROOT_URL=https://bookkeeping.highfly-ai.com/

# ===== 邮件 SMTP（忘记密码/邮箱验证靠它发信）=====
# QQ 邮箱示例：mail.qq.com 设置→账号 开启 IMAP/SMTP 服务，发短信后拿到 16 位「授权码」
# 端口用 465（代码按 465 自动走 SSL）；云服务器一般封出站 25，别用 25
# 注意：QQ 要求发件人地址必须等于认证邮箱，所以 FROM_ADDRESS 必须填同一个 QQ 邮箱
EBK_MAIL_SMTP_HOST=smtp.qq.com:465
EBK_MAIL_SMTP_USER=yourname@qq.com
# 这是 SMTP 授权码，不是邮箱登录密码
EBK_MAIL_SMTP_PASSWD=change_me_qq_smtp_auth_code
EBK_MAIL_FROM_ADDRESS=yourname@qq.com

# ===== 时区（可选，默认 Asia/Shanghai）=====
TZ=Asia/Shanghai
